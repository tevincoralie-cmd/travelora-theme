{% comment %} travelora-faq.liquid {% endcomment %}
<div class="tv-faq">
  <div class="tv-faq__inner">
    <div class="tv-faq__sidebar">
      <span class="tv-section-eyebrow tv-reveal">{{ section.settings.eyebrow }}</span>
      <h2 class="tv-section-title tv-reveal" style="margin-bottom:0;">{{ section.settings.title }}</h2>
      <p class="tv-faq__sidebar-desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.contact_url }}" class="tv-faq__contact">{{ section.settings.contact_label }} →</a>

      {% if section.settings.faq_image %}
        <div class="tv-faq__image">
          <img
            src="{{ section.settings.faq_image | image_url: width: 600 }}"
            alt="{{ section.settings.faq_image.alt | default: 'Travelora' }}"
            loading="lazy"
          >
        </div>
      {% else %}
        <div class="tv-faq__image-placeholder">
          <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="500" fill="#D6E8DF"/>
            <circle cx="200" cy="220" r="120" fill="rgba(92,122,107,0.12)"/>
            <circle cx="200" cy="220" r="80" fill="rgba(92,122,107,0.1)"/>
            <!-- Valise -->
            <rect x="110" y="140" width="180" height="220" rx="12" fill="#EDE8DE" stroke="#A8C4B5" stroke-width="1.5"/>
            <rect x="150" y="118" width="100" height="30" rx="15" fill="#B5A99A"/>
            <line x1="110" y1="250" x2="290" y2="250" stroke="rgba(92,122,107,0.25)" stroke-width="1.5" stroke-dasharray="5 4"/>
            <rect x="170" y="232" width="60" height="36" rx="5" fill="rgba(92,122,107,0.12)" stroke="rgba(92,122,107,0.2)" stroke-width="1"/>
            <circle cx="200" cy="244" r="7" fill="rgba(92,122,107,0.2)"/>
            <circle cx="130" cy="372" r="12" fill="#2C2925"/>
            <circle cx="270" cy="372" r="12" fill="#2C2925"/>
            <!-- Tag -->
            <rect x="146" y="328" width="108" height="24" rx="3" fill="rgba(92,122,107,0.1)" stroke="rgba(92,122,107,0.2)" stroke-width="0.8"/>
            <text x="200" y="344" text-anchor="middle" font-family="Georgia, serif" font-size="10" font-style="italic" fill="#5C7A6B" letter-spacing="1.5">Travelora</text>
            <!-- Avion -->
            <g transform="translate(290, 140)" opacity="0.3">
              <path d="M 30 15 L 0 24 L 6 15 L 0 6 Z" fill="#5C7A6B"/>
              <path d="M 15 3 L 21 15 L 15 15 L 9 3 Z" fill="#7A9E8C"/>
              <path d="M 15 27 L 21 15 L 15 15 L 9 27 Z" fill="#7A9E8C"/>
            </g>
            <!-- Texte bas -->
            <text x="200" y="460" text-anchor="middle" font-family="Georgia, serif" font-size="11" font-style="italic" fill="rgba(92,122,107,0.5)" letter-spacing="2">Voyagez à votre image</text>
          </svg>
        </div>
      {% endif %}
    </div>

    <div class="tv-faq__list">
      {% for block in section.blocks %}
        <div class="tv-faq__item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
          <div class="tv-faq__q" onclick="tvFaq(this)">
            {{ block.settings.question }}
            <span class="tv-faq__icon">+</span>
          </div>
          <div class="tv-faq__a">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .tv-faq__image {
    margin-top: 32px;
    border-radius: 2px;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .tv-faq__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.85);
    transition: transform 0.6s;
  }
  .tv-faq__image:hover img { transform: scale(1.03); }

  .tv-faq__image-placeholder {
    margin-top: 32px;
    border-radius: 2px;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .tv-faq__image-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
function tvFaq(el) {
  const item = el.closest('.tv-faq__item');
  const open = item.classList.contains('open');
  document.querySelectorAll('.tv-faq__item').forEach(i => i.classList.remove('open'));
  if (!open) item.classList.add('open');
}
</script>

{% schema %}
{
  "name": "Travelora — FAQ",
  "settings": [
    { "type": "text",       "id": "eyebrow",       "label": "Eyebrow",            "default": "Questions fréquentes" },
    { "type": "text",       "id": "title",         "label": "Titre",              "default": "Tout ce que vous souhaitez savoir" },
    { "type": "textarea",   "id": "description",   "label": "Description",        "default": "Une question sans réponse ? Notre équipe vous répond rapidement." },
    { "type": "text",       "id": "contact_label", "label": "Texte lien contact", "default": "Nous contacter" },
    { "type": "url",        "id": "contact_url",   "label": "URL contact" },
    { "type": "image_picker", "id": "faq_image",   "label": "Photo lifestyle (sous le texte)" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer",   "label": "Réponse" }
      ]
    }
  ],
  "presets": [{
    "name": "Travelora — FAQ",
    "blocks": [
      { "type": "faq_item", "settings": { "question": "Comment utiliser le code BIENVENUE ?", "answer": "Entrez le code BIENVENUE au moment du paiement pour bénéficier de −10% sur votre première commande. Valable une fois, sans minimum d'achat." } },
      { "type": "faq_item", "settings": { "question": "Quel format d'image envoyer ?", "answer": "JPG ou PNG en haute résolution pour un rendu optimal. Notre outil de prévisualisation vous montre le résultat avant de valider." } },
      { "type": "faq_item", "settings": { "question": "La housse s'adapte-t-elle à toutes les valises ?", "answer": "Oui. Notre tissu élastique s'adapte aux valises de toutes marques et tailles." } },
      { "type": "faq_item", "settings": { "question": "Comment entretenir ma housse ?", "answer": "Lavage délicat à 30°C. Vos couleurs restent intactes voyage après voyage." } },
      { "type": "faq_item", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "Les délais sont calculés selon votre adresse. Livraison offerte en France dès 40€." } }
    ]
  }]
}
{% endschema %}
