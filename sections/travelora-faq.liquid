<section id="faq" class="tv-faq">
  <div class="tv-faq__inner">
    <div class="tv-faq__sidebar">
      <span class="tv-faq__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="tv-faq__title">{{ section.settings.title }}</h2>
      <p class="tv-faq__desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.contact_url }}" class="tv-faq__contact">{{ section.settings.contact_label }} →</a>
      {% if section.settings.faq_image %}
        <div class="tv-faq__image">
          <img src="{{ section.settings.faq_image | image_url: width: 600 }}"
            alt="{{ section.settings.faq_image.alt | default: 'Travelora' }}" loading="lazy">
        </div>
      {% endif %}
    </div>
    <div class="tv-faq__list">
      {% for block in section.blocks %}
        <div class="tv-faq__item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
          <div class="tv-faq__q" onclick="tvFaq(this)">
            {{ block.settings.question }}
            <span class="tv-faq__icon">+</span>
          </div>
          <div class="tv-faq__a">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .tv-faq {
    padding: 88px 72px;
    background: #F5F1EA;
  }
  @media (max-width: 768px) { .tv-faq { padding: 56px 24px; } }

  .tv-faq__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 96px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .tv-faq__inner { grid-template-columns: 1fr; gap: 40px; }
  }

  .tv-faq__eyebrow {
    display: block;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 200;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: #5C7A6B; margin-bottom: 16px;
  }

  .tv-faq__title {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-style: italic; font-weight: 400;
    line-height: 1.1; color: #2C2925;
    margin-bottom: 16px;
  }

  .tv-faq__desc {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13.5px; font-weight: 200;
    color: #B5A99A; line-height: 1.8; margin-bottom: 24px;
  }

  .tv-faq__contact {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: #5C7A6B;
    border-bottom: 1px solid #A8C4B5; padding-bottom: 3px;
    transition: color 0.3s;
  }
  .tv-faq__contact:hover { color: #2C2925; }

  .tv-faq__image {
    margin-top: 28px; border-radius: 2px;
    overflow: hidden; aspect-ratio: 3/4;
  }
  .tv-faq__image img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .tv-faq__list { display: flex; flex-direction: column; }

  .tv-faq__item { border-bottom: 1px solid rgba(44,41,37,0.09); }

  .tv-faq__q {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 0;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13.5px; font-weight: 300; color: #2C2925;
    cursor: pointer; user-select: none; gap: 16px; transition: color 0.2s;
  }
  .tv-faq__q:hover { color: #5C7A6B; }

  .tv-faq__icon {
    width: 24px; height: 24px; border-radius: 50%;
    border: 1px solid #DDD6C6;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 300; color: #B5A99A;
    flex-shrink: 0; line-height: 1;
    transition: transform 0.35s, border-color 0.3s, color 0.3s;
  }
  .tv-faq__item.open .tv-faq__icon {
    transform: rotate(45deg);
    border-color: #5C7A6B; color: #5C7A6B;
  }

  .tv-faq__a {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13px; font-weight: 200; color: #B5A99A; line-height: 1.8;
    max-height: 0; overflow: hidden;
    transition: max-height 0.45s ease, padding 0.35s;
  }
  .tv-faq__item.open .tv-faq__a { max-height: 200px; padding-bottom: 20px; }
</style>

<script>
function tvFaq(el) {
  const item = el.closest('.tv-faq__item');
  const open = item.classList.contains('open');
  document.querySelectorAll('.tv-faq__item').forEach(i => i.classList.remove('open'));
  if (!open) item.classList.add('open');
}
</script>

{% schema %}
{
  "name": "Travelora - FAQ",
  "settings": [
    { "type": "text",         "id": "eyebrow",       "label": "Eyebrow",    "default": "Questions frequentes" },
    { "type": "text",         "id": "title",         "label": "Titre",      "default": "Tout ce que vous souhaitez savoir" },
    { "type": "textarea",     "id": "description",   "label": "Description","default": "Une question sans reponse ? Notre equipe vous repond rapidement." },
    { "type": "text",         "id": "contact_label", "label": "Lien texte", "default": "Nous contacter" },
    { "type": "url",          "id": "contact_url",   "label": "Lien URL" },
    { "type": "image_picker", "id": "faq_image",     "label": "Photo lifestyle" }
  ],
  "blocks": [{
    "type": "faq_item",
    "name": "Question",
    "settings": [
      { "type": "text",     "id": "question", "label": "Question" },
      { "type": "textarea", "id": "answer",   "label": "Reponse" }
    ]
  }],
  "presets": [{ "name": "Travelora - FAQ", "blocks": [
    { "type": "faq_item", "settings": { "question": "Comment utiliser le code BIENVENUE ?", "answer": "Entrez le code BIENVENUE au moment du paiement pour beneficier de -10% sur votre premiere commande." } },
    { "type": "faq_item", "settings": { "question": "Quel format d'image envoyer ?", "answer": "JPG ou PNG en haute resolution pour un rendu optimal." } },
    { "type": "faq_item", "settings": { "question": "La housse s'adapte-t-elle a toutes les valises ?", "answer": "Oui. Notre tissu elastique s'adapte aux valises de toutes marques et tailles." } },
    { "type": "faq_item", "settings": { "question": "Comment entretenir ma housse ?", "answer": "Lavage delicat a 30 degres. Vos couleurs restent intactes voyage apres voyage." } },
    { "type": "faq_item", "settings": { "question": "Quels sont les delais de livraison ?", "answer": "Les delais sont calcules selon votre adresse. Livraison offerte en France des 40 euros." } }
  ]}]
}
{% endschema %}
