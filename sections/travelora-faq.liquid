{% comment %} travelora-faq.liquid {% endcomment %}
<div class="tv-faq">
  <div class="tv-faq__inner">
    <div class="tv-faq__sidebar">
      <span class="tv-section-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="tv-section-title" style="margin-bottom:16px;">{{ section.settings.title }}</h2>
      <p class="tv-faq__sidebar-desc">{{ section.settings.description }}</p>
      <a href="{{ section.settings.contact_url }}" class="tv-faq__contact">{{ section.settings.contact_label }} →</a>
      {% if section.settings.faq_image %}
        <div class="tv-faq__image">
          <img src="{{ section.settings.faq_image | image_url: width: 600 }}"
            alt="{{ section.settings.faq_image.alt | default: 'Travelora' }}" loading="lazy">
        </div>
      {% endif %}
    </div>
    <div class="tv-faq__list">
      {% for block in section.blocks %}
        <div class="tv-faq__item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
          <div class="tv-faq__q" onclick="tvFaq(this)">
            {{ block.settings.question }}
            <span class="tv-faq__icon">+</span>
          </div>
          <div class="tv-faq__a">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .tv-faq { padding: 88px 72px; background: #F5F1EA; }
  @media (max-width: 768px) { .tv-faq { padding: 56px 24px; } }

  .tv-faq__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 96px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .tv-faq__inner { grid-template-columns: 1fr; gap: 40px; }
  }

  .tv-faq__sidebar { position: sticky; top: 80px; }

  .tv-faq__sidebar-desc {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13.5px; font-weight: 200;
    color: #B5A99A; line-height: 1.8;
    margin-bottom: 24px; margin-top: 14px;
  }

  .tv-faq__contact {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 300;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: #5C7A6B;
    border-bottom: 1px solid #A8C4B5; padding-bottom: 3px;
    transition: color 0.3s;
  }
  .tv-faq__contact:hover { color: #2C2925; }

  .tv-faq__image {
    margin-top: 32px; border-radius: 2px;
    overflow: hidden; aspect-ratio: 3/4;
  }
  .tv-faq__image img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(0.85); transition: transform 0.6s;
  }
  .tv-faq__image:hover img { transform: scale(1.03); }

  .tv-faq__list { display: flex; flex-direction: column; }
  .tv-faq__item { border-bottom: 1px solid rgba(44,41,37,0.09); }

  .tv-faq__q {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 0;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13.5px; font-weight: 300;
    color: #2C2925; cursor: pointer; user-select: none;
    gap: 16px; transition: color 0.2s;
  }
  .tv-faq__q:hover { color: #5C7A6B; }

  .tv-faq__icon {
    width: 24px; height: 24px; border-radius: 50%;
    border: 1px solid #DDD6C6;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 300; color: #B5A99A;
    flex-shrink: 0; line-height: 1;
    transition: transform 0.35s, border-color 0.3s, color 0.3s;
  }
  .tv-faq__item.open .tv-faq__icon {
    transform: rotate(45deg);
    border-color: #5C7A6B; color: #5C7A6B;
  }

  .tv-faq__a {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13px; font-weight: 200;
    color: #B5A99A; line-height: 1.8;
    max-height: 0; overflow: hidden;
    transition: max-height 0.45s ease, padding 0.35s;
  }
  .tv-faq__item.open .tv-faq__a { max-height: 200px; padding-bottom: 20px; }
</style>

<script>
function tvFaq(el) {
  const item = el.closest('.tv-faq__item');
  const open = item.classList.contains('open');
  document.querySelectorAll('.tv-faq__item').forEach(i => i.classList.remove('open'));
  if (!open) item.classList.add('open');
}
</script>

{% schema %}
{
  "name": "Travelora — FAQ",
  "settings": [
    { "type": "text",       "id": "eyebrow",       "label": "Eyebrow",            "default": "Questions fréquentes" },
    { "type": "text",       "id": "title",         "label": "Titre",              "default": "Tout ce que vous souhaitez savoir" },
    { "type": "textarea",   "id": "description",   "label": "Description",        "default": "Une question sans réponse ? Notre équipe vous répond rapidement." },
    { "type": "text",       "id": "contact_label", "label": "Texte lien contact", "default": "Nous contacter" },
    { "type": "url",        "id": "contact_url",   "label": "URL contact" },
    { "type": "image_picker", "id": "faq_image",   "label": "Photo lifestyle" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer",   "label": "Réponse" }
      ]
    }
  ],
  "presets": [{
    "name": "Travelora — FAQ",
    "blocks": [
      { "type": "faq_item", "settings": { "question": "Comment utiliser le code BIENVENUE ?", "answer": "Entrez le code BIENVENUE au moment du paiement pour bénéficier de −10% sur votre première commande. Valable une fois, sans minimum d'achat." } },
      { "type": "faq_item", "settings": { "question": "Quel format d'image envoyer ?", "answer": "JPG ou PNG en haute résolution pour un rendu optimal." } },
      { "type": "faq_item", "settings": { "question": "La housse s'adapte-t-elle à toutes les valises ?", "answer": "Oui. Notre tissu élastique s'adapte aux valises de toutes marques et tailles." } },
      { "type": "faq_item", "settings": { "question": "Comment entretenir ma housse ?", "answer": "Lavage délicat à 30°C. Vos couleurs restent intactes voyage après voyage." } },
      { "type": "faq_item", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "Les délais sont calculés selon votre adresse. Livraison offerte en France dès 40€." } }
    ]
  }]
}
{% endschema %}
