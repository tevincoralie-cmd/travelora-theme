{% comment %}<section id="avis" class="tv-testi">
  <div class="tv-testi__inner">
    <div class="tv-testi__head">
      <div>
        <span class="tv-testi__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="tv-testi__title">{{ section.settings.title }}</h2>
      </div>
      <div class="tv-testi__score-wrap">
        <div class="tv-testi__score">{{ section.settings.score }}</div>
        <div class="tv-testi__stars">★★★★★</div>
        <div class="tv-testi__label">Note moyenne</div>
      </div>
    </div>
    <div class="tv-testi__grid">
      {% for block in section.blocks %}
        <div class="tv-testi__card" {{ block.shopify_attributes }}>
          <div class="tv-testi__quote">"</div>
          <p class="tv-testi__text">{{ block.settings.quote }}</p>
          <div class="tv-testi__author">
            <span class="tv-testi__dot"></span>
            <div>
              <div class="tv-testi__name">{{ block.settings.name }}</div>
              <div class="tv-testi__loc">{{ block.settings.location }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section> 
{% endcomment %}

<style>
  .tv-testi {
    background: #FDFCF9;
    padding: 88px 72px;
  }
  @media (max-width: 768px) { .tv-testi { padding: 56px 24px; } }

  .tv-testi__inner {}

  .tv-testi__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
    margin-bottom: 52px;
  }
  @media (max-width: 768px) {
    .tv-testi__head { grid-template-columns: 1fr; gap: 20px; }
  }

  .tv-testi__eyebrow {
    display: block;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 200;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: #5C7A6B; margin-bottom: 16px;
  }

  .tv-testi__title {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(30px, 4vw, 50px);
    font-style: italic; font-weight: 400;
    line-height: 1.1; color: #2C2925;
  }

  .tv-testi__score {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 52px; font-style: italic; font-weight: 300;
    color: #2C2925; line-height: 1; margin-bottom: 6px;
  }

  .tv-testi__stars {
    color: #7A9E8C; font-size: 14px;
    letter-spacing: 3px; margin-bottom: 8px;
  }

  .tv-testi__label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 200;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: #B5A99A;
  }

  .tv-testi__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(44,41,37,0.09);
  }
  @media (max-width: 768px) {
    .tv-testi__grid { grid-template-columns: 1fr; }
  }

  .tv-testi__card {
    background: #FDFCF9;
    padding: 36px 28px;
    transition: background 0.3s;
  }
  .tv-testi__card:hover { background: #EBF3EE; }

  .tv-testi__quote {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 36px; font-style: italic; font-weight: 300;
    color: #A8C4B5; line-height: 1; margin-bottom: 12px;
  }

  .tv-testi__text {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 14px; font-weight: 200; font-style: italic;
    color: #4A4540; line-height: 1.8; margin-bottom: 22px;
  }

  .tv-testi__author {
    display: flex; align-items: center; gap: 12px;
  }

  .tv-testi__dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: #D6E8DF; flex-shrink: 0;
  }

  .tv-testi__name {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 11.5px; font-weight: 300;
    color: #2C2925; letter-spacing: 0.06em;
  }

  .tv-testi__loc {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10.5px; font-weight: 200; color: #B5A99A;
  }
</style>

{% schema %}
{
  "name": "Travelora - Avis clients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Avis clients" },
    { "type": "text", "id": "title",   "label": "Titre",   "default": "Ils en parlent mieux que nous" },
    { "type": "text", "id": "score",   "label": "Note",    "default": "4,8" }
  ],
  "blocks": [{
    "type": "review",
    "name": "Avis",
    "settings": [
      { "type": "textarea", "id": "quote",    "label": "Temoignage" },
      { "type": "text",     "id": "name",     "label": "Nom" },
      { "type": "text",     "id": "location", "label": "Ville et Date" }
    ]
  }],
  "presets": [{ "name": "Travelora - Avis clients", "blocks": [
    { "type": "review", "settings": { "quote": "Ma valise est reconnaissable en un regard sur le tapis. Plus jamais de confusion a l'aeroport.", "name": "Sophie M.", "location": "Paris - Janvier 2026" } },
    { "type": "review", "settings": { "quote": "J'ai mis une photo de mes enfants. C'est devenu un objet de famille, utile et charge de sens.", "name": "Alexandre D.", "location": "Lyon - Fevrier 2026" } },
    { "type": "review", "settings": { "quote": "Idee cadeau parfaite. L'outil est intuitif, le resultat propre. Je recommande sans hesitation.", "name": "Claire B.", "location": "Bordeaux - Mars 2026" } }
  ]}]
}
{% endschema %}
