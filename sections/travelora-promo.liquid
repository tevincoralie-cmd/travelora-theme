{% comment %} travelora-promo.liquid {% endcomment %}
<div class="tv-promo">
  <div class="tv-promo__left">
    <p class="tv-promo__label">{{ section.settings.label }}</p>
    <h2 class="tv-promo__title">{{ section.settings.title }}</h2>
    <p class="tv-promo__desc">{{ section.settings.description }}</p>
  </div>
  <div class="tv-promo__box">
    <p class="tv-promo__box-label">{{ section.settings.code_label }}</p>
    <span class="tv-promo__code">{{ section.settings.code }}</span>
    <p class="tv-promo__discount">{{ section.settings.discount }}</p>
  </div>
</div>

<style>
  .tv-promo {
    background: #5C7A6B;
    padding: 52px 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: nowrap;
  }
  @media (max-width: 768px) {
    .tv-promo { padding: 40px 24px; flex-wrap: wrap; }
  }
  .tv-promo__left {
    flex: 1;
    max-width: 520px;
  }
  .tv-promo__label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 9.5px;
    font-weight: 200;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #A8C4B5;
    margin-bottom: 10px;
  }
  .tv-promo__title {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(22px, 3vw, 34px);
    font-style: italic;
    font-weight: 300;
    color: #FDFCF9;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .tv-promo__desc {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 13px;
    font-weight: 200;
    color: rgba(235,243,238,0.65);
    line-height: 1.75;
  }
  .tv-promo__box {
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 2px;
    padding: 28px 40px;
    text-align: center;
    background: rgba(255,255,255,0.07);
    min-width: 200px;
    max-width: 260px;
  }
  .tv-promo__box-label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 9px;
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #A8C4B5;
    margin-bottom: 10px;
  }
  .tv-promo__code {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 300;
    color: #FDFCF9;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 6px;
  }
  .tv-promo__discount {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 11px;
    font-weight: 200;
    color: #A8C4B5;
    letter-spacing: 0.1em;
  }
</style>

{% schema %}
{
  "name": "Travelora — Code promo",
  "settings": [
    { "type": "text",     "id": "label",       "label": "Eyebrow",      "default": "Offre de bienvenue" },
    { "type": "text",     "id": "title",       "label": "Titre",        "default": "−10% sur votre première commande" },
    { "type": "textarea", "id": "description", "label": "Description",  "default": "Entrez le code au moment du paiement. Valable une fois, sans minimum d'achat." },
    { "type": "text",     "id": "code_label",  "label": "Label code",   "default": "Votre code" },
    { "type": "text",     "id": "code",        "label": "Code promo",   "default": "BIENVENUE" },
    { "type": "text",     "id": "discount",    "label": "Valeur",       "default": "−10% · Première commande" }
  ],
  "presets": [{ "name": "Travelora — Code promo" }]
}
{% endschema %}
