<section class="tv-hiw" id="comment-ca-marche">
  <div class="tv-hiw__inner">
    <div class="tv-hiw__header">
      <span class="tv-hiw__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="tv-hiw__title">{{ section.settings.title }}</h2>
    </div>
    <div class="tv-hiw__timeline">
      {% for block in section.blocks %}
        <div class="tv-hiw__step" {{ block.shopify_attributes }}>
          <div class="tv-hiw__bubble">
            <span class="tv-hiw__icon">{{ block.settings.icon }}</span>
            <span class="tv-hiw__num">0{{ forloop.index }}</span>
          </div>
          {% unless forloop.last %}
            <div class="tv-hiw__arrow">→</div>
          {% endunless %}
          <p class="tv-hiw__label">{{ block.settings.title }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .tv-hiw {
    background: #2C2925;
    padding: 48px 72px;
  }
  @media (max-width: 768px) { .tv-hiw { padding: 36px 24px; } }

  .tv-hiw__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .tv-hiw__eyebrow {
    display: block;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 9px; font-weight: 200;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: #A8C4B5; margin-bottom: 10px;
  }

  .tv-hiw__title {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(20px, 3vw, 32px);
    font-style: italic; font-weight: 300;
    color: #FDFCF9; line-height: 1.1;
  }

  .tv-hiw__timeline {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }

  .tv-hiw__step {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0;
  }

  .tv-hiw__bubble {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
  }

  .tv-hiw__icon {
    width: 52px; height: 52px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(92,122,107,0.4);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    transition: background 0.3s, border-color 0.3s;
  }
  .tv-hiw__step:hover .tv-hiw__icon {
    background: rgba(92,122,107,0.2);
    border-color: #5C7A6B;
  }

  .tv-hiw__num {
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 10px; font-style: italic; font-weight: 300;
    color: #5C7A6B; letter-spacing: 0.08em;
  }

  .tv-hiw__label {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 10px; font-weight: 200;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(245,241,234,0.5);
    text-align: center;
    margin-top: 8px;
    max-width: 80px;
    line-height: 1.5;
    position: absolute;
  }

  .tv-hiw__step {
    position: relative;
    padding-bottom: 40px;
  }

  .tv-hiw__label {
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 90px;
  }

  .tv-hiw__arrow {
    font-size: 18px;
    color: rgba(92,122,107,0.4);
    margin: 0 4px;
    margin-bottom: 30px;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .tv-hiw__timeline { gap: 8px; }
    .tv-hiw__bubble { padding: 0 6px; }
    .tv-hiw__icon { width: 42px; height: 42px; font-size: 16px; }
    .tv-hiw__arrow { font-size: 14px; }
  }
</style>

{% schema %}
{
  "name": "TV - Comment ca marche",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow", "default": "Simple et rapide" },
    { "type": "text", "id": "title",    "label": "Titre",   "default": "De la photo a la valise." }
  ],
  "blocks": [{
    "type": "step",
    "name": "Etape",
    "settings": [
      { "type": "text", "id": "icon",  "label": "Emoji",  "default": "📐" },
      { "type": "text", "id": "title", "label": "Titre",  "default": "Choisissez la taille" }
    ]
  }],
  "presets": [{ "name": "TV - Comment ca marche", "blocks": [
    { "type": "step", "settings": { "icon": "📐", "title": "Choisissez la taille" } },
    { "type": "step", "settings": { "icon": "📸", "title": "Importez votre image" } },
    { "type": "step", "settings": { "icon": "✅", "title": "Previsualisez" } },
    { "type": "step", "settings": { "icon": "📦", "title": "Recevez et voyagez" } }
  ]}]
}
{% endschema %}
