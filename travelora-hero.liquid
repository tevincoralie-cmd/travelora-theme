{% comment %}
  Travelora — Section Hero
  À placer dans : sections/travelora-hero.liquid
{% endcomment %}

<div class="tv-hero">
  <div class="tv-hero__left">
    <span class="tv-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="tv-hero__title">
      {{ section.settings.title_line1 }}<br>
      <em>{{ section.settings.title_line2 }}</em>
    </h1>
    <p class="tv-hero__sub">{{ section.settings.subtitle }}</p>
    <div class="tv-hero__actions">
      <a href="{{ section.settings.cta_url }}" class="tv-btn-primary">
        {{ section.settings.cta_label }}
      </a>
      <a href="{{ section.settings.cta2_url }}" class="tv-btn-text">
        {{ section.settings.cta2_label }} →
      </a>
    </div>
    <div class="tv-hero__price-row">
      <span class="tv-hero__price-label">À partir de</span>
      <span class="tv-hero__price-amount">{{ section.settings.price }}</span>
      <span class="tv-hero__promo-badge">{{ section.settings.promo_code }} −10%</span>
    </div>
  </div>

  <div class="tv-hero__right">
    {% if section.settings.hero_image %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1200 }}"
        alt="{{ section.settings.hero_image.alt | default: 'Travelora' }}"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
        loading="eager"
      >
    {% endif %}
    <span class="tv-hero__right-label">{{ section.settings.eyebrow }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Travelora — Hero",
  "settings": [
    { "type": "text",       "id": "eyebrow",      "label": "Texte eyebrow",   "default": "Collection 2026" },
    { "type": "text",       "id": "title_line1",  "label": "Titre ligne 1",   "default": "Voyagez" },
    { "type": "text",       "id": "title_line2",  "label": "Titre ligne 2 (italique sauge)", "default": "à votre image." },
    { "type": "textarea",   "id": "subtitle",     "label": "Sous-titre",      "default": "Une housse de valise entièrement personnalisée, qui vous ressemble et vous distingue au premier regard." },
    { "type": "text",       "id": "cta_label",    "label": "Bouton principal", "default": "Créer la mienne" },
    { "type": "url",        "id": "cta_url",      "label": "Lien bouton principal" },
    { "type": "text",       "id": "cta2_label",   "label": "Lien secondaire", "default": "Voir les créations" },
    { "type": "url",        "id": "cta2_url",     "label": "Lien secondaire URL" },
    { "type": "text",       "id": "price",        "label": "Prix affiché",    "default": "19,90 €" },
    { "type": "text",       "id": "promo_code",   "label": "Code promo",      "default": "BIENVENUE" },
    { "type": "image_picker", "id": "hero_image", "label": "Image hero (droite)" }
  ],
  "presets": [{ "name": "Travelora — Hero" }]
}
{% endschema %}
